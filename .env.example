# Example environment file for Makefile overrides
# Copy this file to .env and uncomment/modify as needed

# Container runtime (default: podman)
# Uncomment the following line to use Docker instead of Podman
# CONTAINER_RUNTIME=docker

# Container registry settings
# CONTAINER_REGISTRY=quay.io
# CONTAINER_NAMESPACE=cfchase
# CONTAINER_IMAGE_NAME=kubernetes-mcp-server
# CONTAINER_TAG=latest

# Full image name (overrides all above)
# CONTAINER_IMAGE=quay.io/cfchase/kubernetes-mcp-server:latest

# Deployment namespace (default: kubernetes-mcp-server)
# DEPLOY_NAMESPACE=kubernetes-mcp-server

# OAuth Deployment Options
# OAuth proxy image (default: quay.io/openshift/origin-oauth-proxy:4.16)
# OAUTH_PROXY_IMAGE=quay.io/openshift/origin-oauth-proxy:4.16
# Enable OAuth debug logging
# OAUTH_DEBUG=false